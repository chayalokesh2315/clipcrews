rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      match /favorites/{id} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }
    match /creators/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && !('verified' in request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
      // owner edits their profile but can never set `verified` (admins set it in the console);
      // any signed-in user may only change rating fields (reviews)
      allow update: if signedIn() && (
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalReviews']));
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn();
    }
    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      // creator: accept/reject/complete. customer: cancel/dispute. Payments are written only by Cloud Functions.
      allow update: if signedIn() && (
        (resource.data.creatorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && ((resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'rejected'])
            || (resource.data.status == 'paid' && request.resource.data.status == 'completed')))
        || (resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dispute'])
          && request.resource.data.status in ['cancelled', 'disputed']));
    }
    match /notifications/{id} {
      allow create: if signedIn();
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
    }
    // public busy slots used for double-booking checks (no personal data)
    match /busy/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
    }
    // starting point: tighten once chat participants are stored on each chat document
    match /chats/{chatId}/{document=**} { allow read, write: if signedIn(); }
  }
}
